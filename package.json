{
  "name": "wilderguard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/archive-error-maps.mjs && node scripts/build-offline.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "postinstall": "node scripts/fix-capacitor-tar.mjs",
    "android:beta": "npm run android:sync && cd android && ./gradlew assembleBeta",
    "test:release": "python3 -m unittest discover -s tests -p \"test_fdroid_beta.py\" && python3 -m unittest discover -s tests -p \"test_release_workflow.py\"",
    "errors:symbolicate": "node scripts/symbolicate-error.mjs",
    "test:reporting": "node scripts/build-reporting-fixture.mjs && playwright test --config playwright.reporting.config.ts"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@sentry/browser": "10.76.2",
    "@sentry/capacitor": "4.5.0",
    "lucide": "^0.468.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@jridgewell/trace-mapping": "0.3.31",
    "@playwright/test": "^1.56.0",
    "@vitest/coverage-v8": "^5.0.5",
    "fake-indexeddb": "6.2.5",
    "typescript": "^5.9.0",
    "vite": "^6.4.1",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@capacitor/cli": {
      "tar": "^7.5.21"
    }
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
