# EU reporting is disabled unless ALL fields are valid. DSNs are public ingestion keys.
# Never put SENTRY_AUTH_TOKEN, API tokens, signing keys, or passwords in VITE_*.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_DIST=
# Owner selected automatic reporting with a privacy notice and an off switch.
# Example beta metadata for LOCAL testing only; no version/release is being published:
# VITE_SENTRY_ENVIRONMENT=beta
# VITE_SENTRY_RELEASE=com.wilderguard.game.beta@0.1.0-beta.8+8
# VITE_SENTRY_DIST=8

# Gameplay/performance remains off in public builds and release CI.
# Local beta ONLY, after reviewing the provider project privacy and zero-spend settings:
VITE_GAMEPLAY_CHANNEL=
VITE_GAMEPLAY_BUILD=
VITE_POSTHOG_HOST=
VITE_POSTHOG_TOKEN=
VITE_POSTHOG_EPOCH=
VITE_POSTHOG_IP_DISCARD_CONFIRMED=
# EU host must be https://eu.i.posthog.com. TOKEN is a PUBLIC phc_ project token,
# never a personal/API/admin key. EPOCH changes when project/credentials/settings change.
# Confirm project Settings > General > IP data capture is DISCARDED before setting
# IP_DISCARD_CONFIRMED=true. GeoIP is additionally disabled on every event.
# No GameAnalytics secret belongs in VITE_* or client artifacts.
