# EU reporting is disabled unless ALL fields are valid. DSNs are public ingestion keys.
# Never put SENTRY_AUTH_TOKEN, API tokens, signing keys, or passwords in VITE_*.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
VITE_SENTRY_RELEASE=
VITE_SENTRY_DIST=
# Owner selected automatic reporting with a privacy notice and an off switch.
# Example beta metadata for LOCAL testing only; no version/release is being published:
# VITE_SENTRY_ENVIRONMENT=beta
# VITE_SENTRY_RELEASE=com.wilderguard.game.beta@0.1.0-beta.8+8
# VITE_SENTRY_DIST=8
