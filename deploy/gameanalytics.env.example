# Install as ~/.config/wilderguard-relay/server.env with mode 0600.
# Real values belong only in that protected file, never in Git or VITE_*.
GA_GAME_KEY=
GA_GAME_SECRET=
GA_PROJECT_EPOCH=wilderguard-beta-1
GA_ENVIRONMENT=production
GA_ALLOWED_ORIGINS=https://localhost
GA_ALLOWED_TAILSCALE_USERS=YOUR_TAILSCALE_LOGIN
GA_PRIVACY_REVIEWED=true
GA_PRIVATE_RELAY_CONFIRMED=true
GA_RELAY_PORT=8787
# Use an absolute path in a mode-0700 directory; do not use a shell ~ expansion.
GA_STATE_PATH=/ABSOLUTE/PRIVATE/PATH/relay.sqlite
