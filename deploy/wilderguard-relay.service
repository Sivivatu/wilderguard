[Unit]
Description=Wilderguard private beta telemetry relay
After=network-online.target
ConditionPathExists=%h/.config/wilderguard-relay/server.env

[Service]
Type=simple
WorkingDirectory=%h/.local/share/wilderguard-relay/current
EnvironmentFile=%h/.config/wilderguard-relay/server.env
ExecStart=/usr/bin/flock --exclusive --nonblock %h/.local/share/wilderguard-relay/state/relay.lock /usr/bin/node scripts/run-gameanalytics-relay.ts
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/wilderguard-relay/state
MemoryMax=128M

[Install]
WantedBy=default.target
