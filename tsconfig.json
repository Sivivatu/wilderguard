{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler", "strict": true, "skipLibCheck": true,
    "noEmit": true, "allowImportingTsExtensions": true, "isolatedModules": true
  },
  "include": ["src", "tests", "*.ts"]
}
